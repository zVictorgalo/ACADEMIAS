# Copie para .env e substitua a chave por um valor aleatório longo.
SECRET_KEY=SUBSTITUA-POR-UMA-CHAVE-ALEATORIA-DE-PELO-MENOS-50-CARACTERES
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SECURE_COOKIES=0
SECURE_SSL_REDIRECT=0
# Para QR no celular: preencha com o endereço do PC e a porta exposta.
# Exemplo Docker em rede: http://192.168.18.103:8001
PUBLIC_BASE_URL=
